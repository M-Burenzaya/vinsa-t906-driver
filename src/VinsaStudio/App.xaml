<Application x:Class="VinsaStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#1B222A"/>
    <SolidColorBrush x:Key="Mint" Color="#85E2C3"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EEF3"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#2C3943"/><Setter Property="Foreground" Value="#ECF3F5"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#11181E"/><Setter Property="Foreground" Value="#ECF3F5"/><Setter Property="CaretBrush" Value="#85E2C3"/><Setter Property="BorderBrush" Value="#394650"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ECF3F5"/><Setter Property="Margin" Value="0,8,20,8"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#ECF3F5"/><Setter Property="Background" Value="#2C3943"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8"><Grid><ContentPresenter Margin="0,0,18,0"/><TextBlock Text="⌄" HorizontalAlignment="Right"/></Grid></Border></ControlTemplate></ToggleButton.Template>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          </ToggleButton>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#2C3943" CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECF3F5"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#435962"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
