<Window x:Class="VinsaStudio.KeysWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Defined Keys" Width="578" Height="736" MinWidth="520" MinHeight="630" Background="{StaticResource WindowBackground}" FontFamily="Segoe UI" FontSize="14" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
<Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource WindowBackground}" BorderThickness="0"><Viewbox Stretch="Uniform"><Canvas Width="560" Height="674" Background="{StaticResource WindowBackground}">
<Border Canvas.Left="40" Canvas.Top="29" Width="300" Height="600" BorderBrush="#343434" BorderThickness="1" Background="#202020" CornerRadius="8"/>
<UniformGrid x:Name="KeyButtons" Canvas.Left="62" Canvas.Top="63" Width="258" Height="540" Columns="2" Rows="5"/>
<TextBlock Canvas.Left="385" Canvas.Top="61" Text="Button Number:" FontSize="16"/>
<Border Canvas.Left="382" Canvas.Top="86" Width="114" Height="106" Background="#303030" CornerRadius="5"><TextBlock x:Name="ButtonNumber" Text="1" FontSize="86" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<Border Canvas.Left="382" Canvas.Top="212" Width="114" Height="284" BorderBrush="#424242" BorderThickness="1" Background="#202020" CornerRadius="5"/>
<ComboBox x:Name="KeyChoice" Canvas.Left="389" Canvas.Top="234" Width="100" Height="25" IsEnabled="False"/>
<CheckBox x:Name="ShiftKey" Canvas.Left="391" Canvas.Top="280" Content="Shift" IsEnabled="False"/>
<CheckBox x:Name="CtrlKey" Canvas.Left="391" Canvas.Top="326" Content="Ctrl" IsEnabled="False"/>
<CheckBox x:Name="AltKey" Canvas.Left="391" Canvas.Top="372" Content="Alt" IsEnabled="False"/>
<Border Canvas.Left="384" Canvas.Top="426" Width="110" Height="68" Background="#303030" CornerRadius="5"><TextBlock x:Name="KeySummary" Text="E" Margin="4,10" FontSize="16"/></Border>
<Button Canvas.Left="380" Canvas.Top="512" Width="114" Height="70" Background="#484848" BorderThickness="0" IsEnabled="False" ToolTip="Writing key assignments is not yet implemented."><Path Data="M 5,22 L 25,43 L 75,0" Stroke="White" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
<Button Canvas.Left="384" Canvas.Top="591" Width="108" Height="31" Content="Reset" IsEnabled="False" ToolTip="Writing key assignments is not yet implemented."/>
<TextBlock Canvas.Left="40" Canvas.Top="642" Width="490" FontSize="11" Foreground="#A6A6A6" Text="Vendor default assignments shown for reference. Hardware editing is not yet available." TextWrapping="Wrap"/>
</Canvas></Viewbox></Border></Window>