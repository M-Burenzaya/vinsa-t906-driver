<Window x:Class="VinsaStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VinsaStudio.Controls" Title="Vinsa Studio" Width="848" Height="500" MinWidth="760" MinHeight="450" Background="{StaticResource WindowBackground}" FontFamily="Segoe UI" FontSize="14" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource WindowBackground}" BorderThickness="0">
    <Viewbox Stretch="Uniform"><Canvas x:Name="MainFace" Width="840" Height="456" Background="{StaticResource WindowBackground}">
      <Border x:Name="ConnectionPanel" Canvas.Left="16" Canvas.Top="17" Width="342" Height="41" Background="#292929" CornerRadius="5" MouseLeftButtonDown="RefreshConnection"><TextBlock x:Name="ConnectionBadge" Text="Checking tablet…" Foreground="#D6D6D6" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/></Border>
      <Button Canvas.Left="22" Canvas.Top="75" Width="160" Height="31" Content="Screen Mapping" Click="MappingClick" FontSize="16"/>
      <Button Canvas.Left="198" Canvas.Top="75" Width="160" Height="31" Content="Defined Keys" Click="ButtonsClick" FontSize="16"/>
      <CheckBox x:Name="InkCheck" Canvas.Left="16" Canvas.Top="126" Content="Use Windows Ink" Checked="FlagChanged" Unchecked="FlagChanged"/>
      <CheckBox x:Name="LeftCheck" Canvas.Left="16" Canvas.Top="150" Content="Left Hander" Checked="FlagChanged" Unchecked="FlagChanged"/>
      <CheckBox x:Name="TimelineCheck" Canvas.Left="80" Canvas.Top="166" Content="Continuous timeline · 10 s" FontSize="12" Checked="PressureModeChanged" Unchecked="PressureModeChanged" ToolTip="Off: keep pen-event history. On: scroll continuously, including idle time."/>
      <TextBlock Canvas.Left="17" Canvas.Top="195" Text="8192" FontSize="12"/>
      <TextBlock x:Name="PressureValue" Canvas.Left="17" Canvas.Top="285" Text="0" FontSize="12" ToolTip="Pressure normalized from Windows pen input; mouse input is excluded."/>
      <TextBlock Canvas.Left="17" Canvas.Top="394" Text="0" FontSize="12"/>
      <ProgressBar x:Name="PressureGauge" Canvas.Left="60" Canvas.Top="188" Width="18" Height="216" Orientation="Vertical" Minimum="0" Maximum="8192" Value="0" Foreground="#D6D6D6" Background="#181818" BorderBrush="#303030" BorderThickness="1"/>
      <Canvas x:Name="PressureChart" Canvas.Left="80" Canvas.Top="188" Width="284" Height="216" ClipToBounds="True">
        <Canvas.Background><DrawingBrush TileMode="Tile" Viewport="0,0,15,15" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#181818" Geometry="M0,0 H15 V15 H0 Z"/><GeometryDrawing Geometry="M0,0 H15 M0,0 V15"><GeometryDrawing.Pen><Pen Brush="#303030" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Canvas.Background>
        <Polyline x:Name="PressureLine" Stroke="{StaticResource Accent}" StrokeThickness="2" Points="0,214 284,214"/>
      </Canvas>
      <Image Canvas.Left="386" Canvas.Top="5" Width="78" Height="370" x:Name="PenImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Canvas.Left="460" Canvas.Top="19" Text="Pen buttons" FontSize="16"/>
      <TextBlock Canvas.Left="560" Canvas.Top="23" Text="Draft" FontSize="10" Foreground="{StaticResource MutedText}" ToolTip="Saved profile only. Device assignments have not been applied."/>
      <Button Canvas.Left="704" Canvas.Top="11" Width="92" Height="25" Content="Customize…" Click="PenBindingsClick"/>
      <Button x:Name="UpperBindingButton" Canvas.Left="460" Canvas.Top="43" Width="165" Height="27" Content="Upper: Ctrl + Z" Click="UpperBindingClick" ToolTip="Edit the upper pen button profile."/>
      <Button x:Name="LowerBindingButton" Canvas.Left="635" Canvas.Top="43" Width="165" Height="27" Content="Lower: Right click" Click="LowerBindingClick" ToolTip="Edit the lower pen button profile."/>
      <TextBlock Canvas.Left="460" Canvas.Top="82" Text="Pressure fine tune" FontSize="16"/>
      <TextBlock Canvas.Left="472" Canvas.Top="111" Text="Hard" FontSize="16"/>
      <TextBlock Canvas.Left="648" Canvas.Top="88" Text="Preview" FontSize="10" Foreground="{StaticResource MutedText}" ToolTip="Local slider preview only; device pressure tuning is not applied."/>
      <Slider x:Name="PressureTuningSlider" Canvas.Left="546" Canvas.Top="109" Width="162" Height="24" Minimum="-255" Maximum="255" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Local preview: −255 to +255. Device pressure tuning is not applied.">
        <Slider.Template><ControlTemplate TargetType="Slider"><Grid><Rectangle Height="4" Fill="#414141" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track" Height="20" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="36"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#565656" CornerRadius="3"><TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid></ControlTemplate></Slider.Template>
      </Slider>
      <TextBlock Canvas.Left="750" Canvas.Top="111" Text="Soft" FontSize="16"/>
      <Button Canvas.Left="710" Canvas.Top="75" Width="75" Height="25" Content="Reset" Click="ResetPressureClick" ToolTip="Reset the local pressure slider preview to zero."/>
      <InkCanvas x:Name="TestInk" Canvas.Left="468" Canvas.Top="140" Width="338" Height="312" Background="#212121" PreviewStylusDown="PenInput" PreviewStylusMove="PenInput" PreviewStylusUp="PenUp" PreviewStylusInAirMove="PenHover" StylusLeave="PenLeave" StylusOutOfRange="PenLeave"/>
      <local:PenCursorOverlay x:Name="PenCursor" Canvas.Left="468" Canvas.Top="140" Width="338" Height="312"/>
      <Button Canvas.Left="696" Canvas.Top="411" Width="95" Height="34" Content="Clear" Click="ClearClick" FontSize="16"/>
      <Button Canvas.Left="17" Canvas.Top="418" Width="140" Height="35" Content="Website" Click="WebsiteClick" FontSize="16"/>
      <Button Canvas.Left="161" Canvas.Top="418" Width="161" Height="35" Content="Restore default" Click="RestoreClick" FontSize="16" ToolTip="Restore the reconstructed mapping and mode defaults locally."/>
      <ComboBox Canvas.Left="332" Canvas.Top="421" Width="126" Height="26" SelectedIndex="0" FontSize="16"><ComboBoxItem Content="English"/></ComboBox>
      <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
    </Canvas></Viewbox>
  </Border>
</Window>
