<Window x:Class="VinsaStudio.MappingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VinsaStudio.Controls" Title="Screen Mapping" Width="1000" Height="878" MinWidth="800" MinHeight="650" Background="{StaticResource WindowBackground}" FontFamily="Segoe UI" FontSize="14" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
<Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource WindowBackground}" BorderThickness="0"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Viewbox Stretch="Uniform"><Canvas Width="976" Height="742" Background="{StaticResource WindowBackground}">
<local:MappingSurface x:Name="ScreenSurface" Canvas.Left="8" Canvas.Top="0" Width="841" Height="385"/>
<local:MappingSurface x:Name="TabletSurface" Canvas.Left="8" Canvas.Top="391" Width="841" Height="346" IsTablet="True"/>
<StackPanel Canvas.Left="866" Canvas.Top="115" Width="105"><ComboBox x:Name="MonitorChoice" FontSize="12" Margin="0,0,0,12"/><Button x:Name="NextDisplayButton" Content="≡" FontSize="48" Foreground="#A6A6A6" BorderThickness="0" Height="75" ToolTip="Next display"/><Button x:Name="CaptureButton" Content="Refresh" Margin="0,8,0,0"/></StackPanel>
<StackPanel Canvas.Left="866" Canvas.Top="506" Width="105"><Button x:Name="PresetButton" Content="≡" FontSize="48" Foreground="#A6A6A6" BorderThickness="0" Height="75" ToolTip="Cycle original tablet area presets"/><Button x:Name="FullTabletButton" Content="Full area" Margin="0,8,0,0"/></StackPanel>
</Canvas></Viewbox>
<StackPanel Grid.Row="1"><Expander Header="Coordinates and settings" FontSize="12"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Screen" Width="65" VerticalAlignment="Center"/><StackPanel x:Name="ScreenFields" Orientation="Horizontal"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,4"><TextBlock Text="Tablet" Width="65" VerticalAlignment="Center"/><StackPanel x:Name="TabletFields" Orientation="Horizontal"/></StackPanel><TextBlock x:Name="DeviceDetails" TextWrapping="Wrap" FontSize="11" Margin="0,8"/></StackPanel></Expander>
<DockPanel Margin="0,6,0,0"><TextBlock Text="Drag an area to move it; drag its handles to resize." FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LoadButton" Content="Load…" Margin="4,0"/><Button x:Name="SaveButton" Content="Save copy…" Margin="4,0"/><Button x:Name="ApplyButton" Content="Apply mapping…" Margin="4,0" IsEnabled="False"/></StackPanel></DockPanel></StackPanel>
</Grid></Border></Window>